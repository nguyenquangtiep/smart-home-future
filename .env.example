# Copy to .env and adjust. All values here are safe examples.
SMARTHOME_APP_NAME=Smart Home Future API
SMARTHOME_ENVIRONMENT=local
SMARTHOME_LOG_LEVEL=INFO
# Optional, reserved for a future LLM node. Leave empty: the sample flow does not need it.
SMARTHOME_LLM_API_KEY=

# Device control. "simulator" is the only gateway implemented so far.
SMARTHOME_DEVICE_GATEWAY=simulator
SMARTHOME_SIM_LATENCY_S=0.3
SMARTHOME_VERIFY_TIMEOUT_S=5
SMARTHOME_DISPATCH_TIMEOUT_S=3
SMARTHOME_CONFIRMATION_TTL_S=120
# Development-only identity via the X-Dev-User header (no real auth yet). Never in production.
SMARTHOME_DEV_IDENTITY_ENABLED=true

# Command verification and idempotency.
SMARTHOME_IDEMPOTENCY_TTL_S=86400
SMARTHOME_VERIFICATION_CLOCK_SKEW_S=1

# Durable storage (required when SMARTHOME_ENVIRONMENT=production). Empty = in-memory, dev only.
# Example: postgresql://smarthome:change-me@127.0.0.1:5432/smarthome
# Then run: python -m smarthome.persistence upgrade
SMARTHOME_DATABASE_URL=
SMARTHOME_COMMAND_RETENTION_DAYS=90
SMARTHOME_AUDIT_RETENTION_DAYS=365

# Tests only: admin connection to a Postgres server where test databases may be created.
# SMARTHOME_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
