# Copy to .env and adjust. All values here are safe examples.
SMARTHOME_APP_NAME=Smart Home Future API
# One of: local, test, staging, production. Anything else is refused at startup. Outside
# local/test the app requires SMARTHOME_DATABASE_URL and SMARTHOME_ALLOWED_ORIGINS, refuses the
# dev identity and insecure cookies, and serves no /docs or simulator route.
SMARTHOME_ENVIRONMENT=local
SMARTHOME_LOG_LEVEL=INFO
# Optional, reserved for a future LLM node. Leave empty: the sample flow does not need it.
SMARTHOME_LLM_API_KEY=

# Device control. "simulator" is the only gateway implemented so far.
SMARTHOME_DEVICE_GATEWAY=simulator
SMARTHOME_SIM_LATENCY_S=0.3
SMARTHOME_VERIFY_TIMEOUT_S=5
SMARTHOME_DISPATCH_TIMEOUT_S=3
SMARTHOME_CONFIRMATION_TTL_S=120
# Development-only identity via the X-Dev-User header. Refused outside local/test. With a database
# configured you can instead create an owner (python -m smarthome.auth create-owner) and log in.
SMARTHOME_DEV_IDENTITY_ENABLED=true

# Login (needs the database). Session cookie is HttpOnly, SameSite=Strict and Secure; set
# SMARTHOME_COOKIE_SECURE=false only for plain-http local work (refused elsewhere).
# SMARTHOME_COOKIE_SECURE=true
# Origins allowed to log in and to send state-changing requests, comma separated.
# SMARTHOME_ALLOWED_ORIGINS=https://home.example
# Reverse proxies whose X-Forwarded-For / -Proto are trusted (IPs or CIDR). Empty = trust none.
# SMARTHOME_TRUSTED_PROXY_IPS=
# SMARTHOME_SESSION_IDLE_DAYS=7
# SMARTHOME_SESSION_MAX_DAYS=30
# SMARTHOME_LOGIN_MAX_FAILURES_EMAIL=5
# SMARTHOME_LOGIN_MAX_FAILURES_IP=30

# Command verification and idempotency.
SMARTHOME_IDEMPOTENCY_TTL_S=86400
SMARTHOME_VERIFICATION_CLOCK_SKEW_S=1

# Durable storage (required outside local/test). Empty = in-memory demo home, dev only.
# Example: postgresql://smarthome:change-me@127.0.0.1:5432/smarthome
# Then run: python -m smarthome.persistence upgrade
# and, for local/test only: python -m smarthome.persistence seed-demo
SMARTHOME_DATABASE_URL=
SMARTHOME_COMMAND_RETENTION_DAYS=90
SMARTHOME_AUDIT_RETENTION_DAYS=365

# Tests only: admin connection to a Postgres server where test databases may be created.
# SMARTHOME_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
